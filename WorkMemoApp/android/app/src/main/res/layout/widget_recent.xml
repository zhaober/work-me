<?xml version="1.0" encoding="utf-8"?>
<!-- 近日课程小组件（4x2）：深色卡片 + 黄色强调条 + 今天/明天/后天三列彩色课程块 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_dark"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 强调条必须是 TextView：RemoteViews 只放行带 @RemoteView 注解的类，
             用 <View> 会导致整个布局 inflate 失败（桌面报"载入窗口小部件时出现问题"） -->
        <TextView
            android:layout_width="3dp"
            android:layout_height="13dp"
            android:layout_marginEnd="6dp"
            android:background="#F5C518" />

        <TextView
            android:id="@+id/wr_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="近日课程"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="7dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wr_d1_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#CCFFFFFF" />

            <TextView
                android:id="@+id/wr_d1_c1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:padding="4dp"
                android:background="@drawable/wc_bg_empty"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:maxLines="3"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/wr_d1_c2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="4dp"
                android:background="@drawable/wc_bg_empty"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:maxLines="3"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/wr_d1_c3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="4dp"
                android:background="@drawable/wc_bg_empty"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:maxLines="3"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/wr_d2_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#CCFFFFFF" />

            <TextView
                android:id="@+id/wr_d2_c1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:padding="4dp"
                android:background="@drawable/wc_bg_empty"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:maxLines="3"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/wr_d2_c2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="4dp"
                android:background="@drawable/wc_bg_empty"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:maxLines="3"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/wr_d2_c3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="4dp"
                android:background="@drawable/wc_bg_empty"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:maxLines="3"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/wr_d3_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#CCFFFFFF" />

            <TextView
                android:id="@+id/wr_d3_c1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:padding="4dp"
                android:background="@drawable/wc_bg_empty"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:maxLines="3"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/wr_d3_c2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="4dp"
                android:background="@drawable/wc_bg_empty"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:maxLines="3"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/wr_d3_c3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="4dp"
                android:background="@drawable/wc_bg_empty"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:maxLines="3"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
